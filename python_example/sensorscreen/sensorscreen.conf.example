# K10 Bot sensorscreen configuration
# Copy to sensorscreen.conf and customize, or pass equivalent --flags on the CLI.

[bot]
bot_ip = 192.168.1.178
bot_port = 24642
bot_token = 6DEE8
bot_timeout = 2.0
lidar_hz = 10
geomag_hz = 10
imu_hz = 10
huskylens_hz = 10
# IMU bump detection: threshold (50-1900 mg) and debounce (0-2000 ms); firmware defaults shown.
imu_bump_threshold_mg = 50
imu_bump_debounce_ms = 200

[servos]
# Each channel is fixed as S1 through S6 (firmware channels 0 through 5).
# Valid values: angle180, angle270, continuous.
s1_type = continuous
s2_type = continuous
s3_type = angle270
s4_type = angle270
s5_type = angle180
s6_type = angle180

# Optional per-servo angle limits for angular servos.
# Values must remain within the servo type range (0..180 or 0..270).
# Omit these keys to use full range defaults.
s3_min_angle = 0
s3_max_angle = 270
s4_min_angle = 0
s4_max_angle = 270
